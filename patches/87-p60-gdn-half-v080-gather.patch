+// build_rs puts the layer name on a zero-offset VIEW of the gather in v0.8.0.
+// Follow only storage-preserving edges, and validate the row contract actually used by the kernel.
+static const ggml_tensor * p60_gdn_gather(const ggml_tensor * t, int64_t width) {
+    while (t && (t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE)) {
+        if (t->view_offs != 0 || !ggml_is_contiguous(t) || ggml_nelements(t) != width) {
+            return nullptr;
+        }
+        t = t->src[0];
+    }
+    if (!t || t->op != GGML_OP_GET_ROWS || !t->src[0] || !t->src[1] ||
+            !p60_f32_vec(t, width) || t->ne[0] != width ||
+            t->src[0]->type != GGML_TYPE_F32 || t->src[0]->ne[0] != width ||
+            t->src[0]->nb[0] != sizeof(float) || t->src[0]->nb[1] != width*sizeof(float) ||
+            t->src[0]->ne[2] != 1 || t->src[0]->ne[3] != 1 ||
+            t->src[1]->type != GGML_TYPE_I32 || ggml_nelements(t->src[1]) != 1 || !ggml_is_contiguous(t->src[1])) {
+        return nullptr;
+    }
+    return t;
+}
