diff --git a/ggml/src/ggml-cuda/allreduce.cu b/ggml/src/ggml-cuda/allreduce.cu
index 39b23bed7..5f69320ec 100644
--- a/ggml/src/ggml-cuda/allreduce.cu
+++ b/ggml/src/ggml-cuda/allreduce.cu
@@ -71,6 +71,10 @@ static __device__ __forceinline__ int ggml_cuda_ar_signal_get(const int * p) {
 // false-sharing stalls on the polling GPU.
 static constexpr size_t GGML_CUDA_AR_ARRIVAL_STRIDE = 64;
 
+// Spin backoff for CUDA below Volta, which has no __nanosleep.  128 cycles is ~100ns at the
+// P100's 1328 MHz boost clock, matching the __nanosleep(100) it stands in for.
+static constexpr long long GGML_CUDA_AR_SPIN_BACKOFF_CYCLES = 128;
+
 // Number of blocks the chunked kernel launches with.  Each block stripes a
 // disjoint slice of the data and synchronizes through its own arrival-token
 // slot so multiple SMs can pump PCIe stores in parallel.
@@ -168,7 +172,11 @@ static __global__ void ggml_cuda_ar_kernel(
 #elif __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
             __nanosleep(100);
 #else
-            NO_DEVICE_CODE;
+            // The backoff only has to keep the poller off the PCIe link; clock64() is per-SM and
+            // monotonic within a launch, which is all this needs.  Only tid 0 spins, and the
+            // __syncthreads() below is reached by the rest of the block while it does.
+            const long long t_backoff = clock64();
+            while (clock64() - t_backoff < GGML_CUDA_AR_SPIN_BACKOFF_CYCLES) {}
 #endif // GGML_USE_HIP
         }
     }
@@ -405,14 +413,17 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
         return nullptr;
     }
 
-    // The chunked kernel uses __nanosleep (NVIDIA, sm70+) or
-    // __builtin_amdgcn_s_sleep (AMD).
+    // The chunked kernel spins with __nanosleep (Volta+), __builtin_amdgcn_s_sleep (AMD) or the
+    // clock64() backoff above (Pascal).  Off by default: the Pascal path reduces in a different
+    // order than the fallback, so enable it only where the output has been checked.
+    static const bool ar_pascal = getenv("GGML_CUDA_AR_PASCAL") && atoi(getenv("GGML_CUDA_AR_PASCAL")) != 0;
+    const int cc_min = ar_pascal ? GGML_CUDA_CC_PASCAL : GGML_CUDA_CC_VOLTA;
     for (size_t i = 0; i < n_devices; ++i) {
         const int cc = ggml_cuda_info().devices[devices[i]].cc;
-        if (cc < GGML_CUDA_CC_VOLTA) {
+        if (cc < cc_min) {
             GGML_LOG_DEBUG("%s: internal AllReduce requires compute capability >= %d "
                            "(device %d has cc=%d); falling back\n",
-                           __func__, GGML_CUDA_CC_VOLTA, devices[i], cc);
+                           __func__, cc_min, devices[i], cc);
             return nullptr;
         }
     }
