+    // GGML_CUDA_P60_EXACT: run a multi-token MUL_MAT_ID one token at a time, so each token is bit-identical to decode.
+    // The multi-token MoE kernel uses one warp per token and sums K in another order for some types.
+    if (ids && dst->ne[2] > 1 && ctx.p60_exact) {
+        for (int64_t t = 0; t < dst->ne[2]; t++) {
+            ggml_tensor s1 = *src1; s1.ne[2] = 1; s1.data = (char *) src1->data + t*src1->nb[2];
+            ggml_tensor id = *ids;  id.ne[1] = 1; id.data = (char *) ids->data  + t*ids->nb[1];
+            ggml_tensor d  = *dst;  d.ne[2]  = 1; d.data  = (char *) dst->data  + t*dst->nb[2];
+            ggml_cuda_mul_mat_vec_q(ctx, src0, &s1, &id, &d, fusion);
+        }
+        return;
+    }
+    // Same for dense: the generic table uses 4 warps for 1-4 columns but 2 warps for 5-8, so split into chunks of 4.
+    if (!ids && dst->ne[1] > 4 && dst->ne[2] == 1 && dst->ne[3] == 1 && ctx.p60_exact) {
+        for (int64_t c0 = 0; c0 < dst->ne[1]; c0 += 4) {
+            ggml_tensor s1 = *src1; s1.ne[1] = std::min<int64_t>(4, dst->ne[1] - c0); s1.data = (char *) src1->data + c0*src1->nb[1];
+            ggml_tensor d  = *dst;  d.ne[1]  = s1.ne[1];                              d.data  = (char *) dst->data  + c0*dst->nb[1];
+            ggml_cuda_mul_mat_vec_q(ctx, src0, &s1, nullptr, &d, fusion);
+        }
+        return;
+    }
+
     if (ggml_cuda_mmvq_p60(ctx, src0, src1, ids, dst, fusion)) {
         return;
     }
