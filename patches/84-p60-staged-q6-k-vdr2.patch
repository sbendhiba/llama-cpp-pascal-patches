+// Q6_K x q8_1, 1-3 columns, on the GENERIC table, for the vdr 2 mapping llama.cpp v0.8.0 uses: same per-lane
+// products, accumulation order and reduction as mul_mat_vec_q<GGML_TYPE_Q6_K, ncols_dst, false>, so the output
+// is bit-identical, but the 4 rows of each chunk are staged through shared memory with coalesced 8-byte loads
+// (q6_K rows are 210 B per superblock, so only 2-byte aligned on their own) and the next chunk loads while
+// this one is summed. With qi=32 and vdr=2 a warp takes two superblocks at a time - lanes 0..15 the first and
+// lanes 16..31 the second, each with iqs = 2*(lane%16) - and the block covers vdr*nwarps*warp_size/qi = 8
+// superblocks per row per iteration, which is what a chunk stages.
+template <int ncols_dst>
+static __global__ void __launch_bounds__(4*WARP_SIZE, 1) mul_mat_vec_q6_K_staged(
+        const char * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst, const int64_t row_bytes,
+        const int nchunks, const int blocks_per_row_x, const int stride_col_y, const int stride_col_dst) {
+    constexpr int nwarps = 4, rows = 4, warp_size = WARP_SIZE, vdr = VDR_Q6_K_Q8_1_MMVQ, qi = QI6_K;
+    constexpr int sbs = vdr*nwarps*warp_size/qi;                    // superblocks per row and chunk
+    constexpr int ch  = sbs*sizeof(block_q6_K)/8;                   // uint2 per row and chunk
+    constexpr int tot = rows*ch;
+    constexpr int per = (tot + nwarps*warp_size - 1)/(nwarps*warp_size);
+    static_assert(QI6_K == 32 && vdr == 2 && sbs == 8 && sbs*sizeof(block_q6_K) % 8 == 0,
+                  "mapping assumes the generic vdr 2 block step");
+
+    __shared__ uint2 sm[tot];
+    const int tid  = warp_size*threadIdx.y + threadIdx.x;
+    const int row0 = rows*blockIdx.x;
+    const int kbx_local = 2*threadIdx.y + (threadIdx.x/(qi/vdr));    // this thread's superblock within a chunk
+    const int iqs       = vdr*(threadIdx.x % (qi/vdr));              // and its first quant, as in stock
+
+    uint2 g[per];
+    auto load = [&](const int c) {
+        // the last chunk is 4 superblocks wide when ne00/QK_K % 8 == 4, which is still 8-byte aligned
+        const int ch_c = min(sbs, blocks_per_row_x - c*sbs) * (int) sizeof(block_q6_K)/8;
+#pragma unroll
+        for (int j = 0; j < per; ++j) {
+            const int idx = tid + nwarps*warp_size*j;
+            if (idx < tot && (idx % ch) < ch_c) {
+                g[j] = __ldg((const uint2 *) (vx + (int64_t) (row0 + idx/ch)*row_bytes) + c*ch + idx % ch);
+            }
+        }
+    };
+    load(0);
+
+    float tmp[ncols_dst][rows] = {{ 0.0f }};
+    for (int c = 0; c < nchunks; ++c) {
+        if (c > 0) {
+            __syncthreads();
+        }
+#pragma unroll
+        for (int j = 0; j < per; ++j) {
+            const int idx = tid + nwarps*warp_size*j;
+            if (idx < tot) {
+                sm[idx] = g[j];
+            }
+        }
+        __syncthreads();
+        if (c + 1 < nchunks) {
+            load(c + 1);
+        }
+        const int kbx = c*sbs + kbx_local;
+        if (kbx < blocks_per_row_x) {
+            const int kby = kbx * (QK_K/QK8_1);
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < rows; ++i) {
+                    tmp[j][i] += vec_dot_q6_K_q8_1((const char *) (sm + i*ch), &y[j*stride_col_y + kby], kbx_local, iqs);
+                }
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1][ncols_dst][rows][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i && uint32_t(row0 + i) < (uint32_t) stride_col_dst) {
+                dst[j*stride_col_dst + row0 + i] = tmp[j][i];
+            }
+        }
+    }
+}
