diff --git a/ggml/src/ggml-cuda/vecdotq-p100.cuh b/ggml/src/ggml-cuda/vecdotq-p100.cuh
index be66bc4..b5e96f6 100644
--- a/ggml/src/ggml-cuda/vecdotq-p100.cuh
+++ b/ggml/src/ggml-cuda/vecdotq-p100.cuh
@@ -575,3 +575,52 @@ static __device__ __forceinline__ float vec_dot_iq4_xs_q8_1_p100(
     return d * sumi;
 }
 // ---- end leg ---------------------------------------------------------------------------------
+
+// P100 (sm_60) rewrite of the q6_K x q8_1 mmvq dot. Upstream folds each 4-bit pair to float and
+// multiplies by the scale per (group, column); this runs the whole vdr-wide group through an
+// integer accumulator per column and converts once. The scale, the q8_1 `.ds` and the block d are
+// constant across the group, so the int->float conversion and the two XMAD scale multiplies
+// (Pascal has no IMAD) collapse from vdr*QR6_K to QR6_K. The 6-bit values are pre-scaled by 4 (the
+// sign lands in bit 7 after the XOR); the 0.25f below undoes it exactly, being a power of two.
+// Peak |acc| = vdr*4*128*128 = 262144, inside float's exactly-representable integer range, so the
+// group-fold loses nothing and rounds less often than the upstream path.
+#define VDR_Q6_K_Q8_1_MMVQ_P100 4
+
+static __device__ __forceinline__ float vec_dot_q6_K_q8_1_p100(
+        const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q6_K * bq6_K = (const block_q6_K *) vbq + kbx;
+
+    // mmvq drives kqs = vdr * (tid % (qi/vdr)), so iqs is a multiple of vdr. The bq8/scale/vh
+    // indices floor-divide by moduli that are multiples of vdr, so all vdr lanes share them; the
+    // ql, qh and q8_1 lane indices step by one across the group.
+    const int bq8_offset   = 2 * QR6_K * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/4);
+    const int scale_offset = (QI6_K/4) * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/8);
+    const int vh_shift     = 2 * ((iqs % (QI6_K/2)) / (QI6_K/4));
+    const int qh_idx       = (QI6_K/4) * (iqs / (QI6_K/2)) + iqs % (QI6_K/4);
+
+    const int8_t * scales = bq6_K->scales + scale_offset;
+
+    int acc[QR6_K] = { 0 };
+#pragma unroll
+    for (int l = 0; l < VDR_Q6_K_Q8_1_MMVQ_P100; ++l) {
+        const int vl = get_int_b2(bq6_K->ql, iqs + l);
+        const int vh = get_int_b2(bq6_K->qh, qh_idx + l) >> vh_shift;
+#pragma unroll
+        for (int i = 0; i < QR6_K; ++i) {
+            const int vil4 = (4*i >= 2 ? (vl >> (4*i - 2)) : (vl << (2 - 4*i))) & 0x3C3C3C3C;
+            const int vih4 = ((vh << (6 - 4*i)) & 0xC0C0C0C0) ^ 0x80808080;
+            const int u    = get_int_b4(bq8_1[bq8_offset + 2*i].qs, (iqs + l) % QI8_1);
+            acc[i] = ggml_cuda_dp4a(vil4 | vih4, u, acc[i]);
+        }
+    }
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int i = 0; i < QR6_K; ++i) {
+        sumf += (__low2float(bq8_1[bq8_offset + 2*i].ds) * (float) scales[4*i]) * (float) acc[i];
+    }
+
+    const float d = bq6_K->d;
+    return d * 0.25f * sumf;
+}
