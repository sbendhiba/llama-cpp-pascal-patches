+void ggml_cuda_p60_ssm_conv_state(ggml_backend_cuda_context & ctx, const ggml_tensor * ssm_conv, ggml_tensor * silu_dst) {
+    const auto & e = ctx.p60_conv_state;
+    GGML_ASSERT(e.ssm_conv == ssm_conv && e.n_writes <= e.max_writes);
+
+    const ggml_tensor * wt  = ssm_conv->src[1];
+    const int64_t       nc  = wt->ne[0];
+    const int64_t       nr  = ssm_conv->src[0]->ne[1];
+    const int64_t       n_t = silu_dst->ne[1];
+    GGML_ASSERT(nc == 4 && nr % 128 == 0 && silu_dst->ne[2] == 1 && silu_dst->nb[0] == sizeof(float));
+
+    p60_conv_writes wr = {};
+    wr.n = e.n_writes;
+    for (int k = 0; k < e.n_writes; ++k) {
+        wr.dst[k] = e.wdst[k];
+        wr.src[k] = e.wsrc[k];
+    }
+
+    const dim3 blocks(1, nr / 128, 1);
+    ssm_conv_state_f32<true, 4><<<blocks, 128, 0, ctx.stream()>>>(
+        e.base, e.ids, e.row, e.x, e.xs_t, e.xs_c, (const float *) wt->data, (int) (wt->nb[1] / sizeof(float)),
+        (float *) silu_dst->data, silu_dst->nb[1] / (int64_t) sizeof(float), n_t, wr);
+}
