+// cuBLAS's COMPUTE_16F algorithms split into two accuracy families on GP100: ALGO1-3 accumulate each
+// output in one long fp16 chain, ALGO4-6 in blocks.  CUBLAS_GEMM_DEFAULT_TENSOR_OP picks a long chain
+// from ~256 rows up, which is both the less accurate and, at 512-1024 rows, the slower choice.
+// GGML_CUDA_CUBLAS_ALGO_PASCAL selects the algorithm by number; -1 keeps upstream's choice.
+// ALGO7 and above are not supported for COMPUTE_16F, so the range is capped at 6 here.
+//
+// On 2x P100, Qwen3.8-27B Q4_0, -sm tensor, 5 interleaved rounds in one build (the off arm reached
+// through GGML_CUDA_CUBLAS_ALGO_PASCAL=-1): pp512 242.92 -> 369.04 t/s, pp1024 306.73 -> 396.02,
+// pp2048 -0.8%, tg128 -0.1%.  On the 35B MoE at pp4096 all four numbers are within 0.6%.
+// Wikitext-2 over 20 chunks of 4096, -ub 2048: PPL 6.2785 with the default algo, 6.2658 with ALGO6,
+// and 6.2645 for the all-fp32 matmul reference (GGML_CUDA_CUBLAS_COMPUTE_TYPE=f32) - so ALGO6 sits
+// 10x closer to fp32 than the default it replaces, in the same direction as that reference.
+// Any failure below retries with the default, so an unsupported algorithm costs nothing.
+static cublasGemmAlgo_t ggml_cuda_cublas_algo(const int cc, const cublasComputeType_t compute_type) {
+    static const cublasGemmAlgo_t algo = []() {
+        const char * env = getenv("GGML_CUDA_CUBLAS_ALGO_PASCAL");
+        const int v = env ? atoi(env) : 6;
+        switch (v) {
+            case 0: return CUBLAS_GEMM_ALGO0;
+            case 1: return CUBLAS_GEMM_ALGO1;
+            case 2: return CUBLAS_GEMM_ALGO2;
+            case 3: return CUBLAS_GEMM_ALGO3;
+            case 4: return CUBLAS_GEMM_ALGO4;
+            case 5: return CUBLAS_GEMM_ALGO5;
+            case 6: return CUBLAS_GEMM_ALGO6;
+            default: return CUBLAS_GEMM_DEFAULT_TENSOR_OP;
+        }
+    }();
+
+    if (compute_type == CUBLAS_COMPUTE_16F && cc == GGML_CUDA_CC_PASCAL) {
+        return algo;
+    }
+
+    return CUBLAS_GEMM_DEFAULT_TENSOR_OP;
+}
